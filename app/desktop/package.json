{
  "name": "@restaurant/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "package": "electron-builder --dir",
    "make": "electron-builder",
    "dist": "electron-builder --publish never"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "cross-env": "^10.1.0",
    "electron-updater": "^6.6.2",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "electron": "^39.8.10",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.desktopapprevisited.restaurant",
    "productName": "Restaurant Order Manager",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      {
        "from": "../backend/src",
        "to": "backend/src",
        "filter": ["**/*"]
      },
      {
        "from": "../frontend/dist",
        "to": "frontend/dist",
        "filter": ["**/*"]
      }
    ],
    "extraMetadata": {
      "name": "restaurant-order-manager"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "FIBA00",
        "repo": "Order-mgmt"
      }
    ]
  }
}
