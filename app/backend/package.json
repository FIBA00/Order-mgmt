{
  "name": "@restaurant/backend",
  "version": "0.1.0",
  "private": true,
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon  src/server.js",
    "start": "nodemon src/server.js",
    "test": "nodemon --test",
    "lint": "prettier --write .",
    "db:generate:sqlite": "drizzle-kit generate --config=drizzle.sqlite.config.js",
    "db:generate:postgres": "drizzle-kit generate --config=drizzle.postgres.config.js",
    "db:migrate:sqlite": "node src/database/migrate.js sqlite",
    "db:migrate:postgres": "node src/database/migrate.js postgres"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "body-parser": "^2.3.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "drizzle-kit": "^0.31.1",
    "drizzle-orm": "^0.44.2",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mocha": "^12.0.2",
    "morgan": "^1.12.1",
    "nodemon": "^3.1.14",
    "pg": "^8.16.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.8",
    "supertest": "^7.3.0",
    "zod": "^4.1.5"
  }
}
